# exo node image for the Experiment 3 harness (Linux CPU backend).
# Build once:  podman build -t exo-node -f measure/exo/Containerfile measure/exo
# Pin the exo commit the measurements were taken at; bump deliberately.
ARG EXO_COMMIT=bc412e2

FROM docker.io/library/python:3.13-slim

ARG EXO_COMMIT
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl ca-certificates build-essential nodejs npm iproute2 iputils-ping \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv

WORKDIR /opt
RUN git clone https://github.com/exo-explore/exo && cd exo && git checkout ${EXO_COMMIT}
WORKDIR /opt/exo
RUN cd dashboard && npm install && npm run build && cd ..
RUN uv sync --extra mlx-cpu

# exo's mlx-cpu extra is broken at this commit (still so on main as of 2026-10-23, see
# https://github.com/exo-explore/exo/issues/2359): it pairs
# the mlx binding from a JACCL-fix fork (a CUDA build, no CPU lib in that release) with
# mlx-cpu 0.31.2 from PyPI, and the runner dies on import with an undefined
# mlx::core::linalg::det symbol. No PyPI mlx-cpu matches the fork's binding; the official
# mlx 0.32.0 binding resolves every symbol against mlx-cpu 0.32.0 (checked with nm), and is
# the pair upstream mlx declares for mlx[cpu]. The fork only fixes JACCL (RDMA); the
# harness uses MlxRing. --reinstall because the fork's wheel also calls itself 0.32.0, so uv
# would otherwise keep it; the direct_url.json check fails the build if it is still the fork.
ARG MLX_VERSION=0.32.0
RUN uv pip install --python .venv/bin/python --no-deps --reinstall \
        "mlx==${MLX_VERSION}" "mlx-cpu==${MLX_VERSION}" \
    && .venv/bin/python -c "import importlib.metadata as m; \
assert m.distribution('mlx').read_text('direct_url.json') is None, 'mlx still from a URL (fork)'; \
import mlx.core as mx; mx.eval(mx.linalg.det(mx.eye(2), stream=mx.cpu))"

# per-node state (pid, logs, downloaded models) lives here; mount a volume per node
ENV EXO_HOME=/data
VOLUME /data

# 52413/udp discovery, 52414/tcp zenoh, 52415/tcp API
EXPOSE 52413/udp 52414/tcp 52415/tcp
# --no-sync: plain `uv run` re-syncs to uv.lock on every start, undoing the mlx override above
ENTRYPOINT ["uv", "run", "--no-sync", "exo"]
